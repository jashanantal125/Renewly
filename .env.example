# Renewly — optional email reminder setup.
#
# The app runs without any of these: it stays a local, offline renewal tracker
# and the Gmail sign-in button is hidden. Fill these in to enable email nudges.
# Copy to .env.local for development.

# --- Google sign-in -----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Add these Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Database -----------------------------------------------------------------
# MongoDB Atlas connection string (a free M0 cluster is enough).
MONGODB_URI=
MONGODB_DB=renewly

# --- Sending mail -------------------------------------------------------------
# A Gmail account plus an App Password (Google Account > Security >
# 2-Step Verification > App passwords). Chosen over a transactional provider
# because it needs no verified domain, so reminders can reach any address.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Scheduled job ------------------------------------------------------------
# Protects /api/cron/reminders. On Vercel this same value is sent automatically
# as `Authorization: Bearer $CRON_SECRET` by Vercel Cron.
#   openssl rand -hex 32
CRON_SECRET=

# Public URL, used for the OAuth redirect and links inside emails. Falls back to
# the request origin when unset, which is fine locally.
APP_URL=http://localhost:3000
